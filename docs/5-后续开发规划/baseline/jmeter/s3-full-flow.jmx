<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="D1 S3 完整链路">
      <boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S3 100人查询购票支付">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,100)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp,5)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.delayedStart">false</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S3 query-purchase-pay">
          <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">s3-full-flow-v2</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.time.Duration
import java.time.LocalDate

def client = vars.getObject('d1.http.client')
if (client == null) {
    client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()
    vars.putObject('d1.http.client', client)
}
def lines = props.get('d1.user.lines')
if (lines == null) {
    synchronized (props) {
        lines = props.get('d1.user.lines')
        if (lines == null) {
            lines = new File(props.getProperty('userFile')).readLines('UTF-8').drop(1)
            props.put('d1.user.lines', lines)
        }
    }
}
def fields = lines[ctx.getThreadNum()].split(',', 3)
def baseUrl = props.getProperty('baseUrl', 'http://127.0.0.1:9000')
def send = { String method, String path, Object payload, boolean authenticated ->
    def builder = HttpRequest.newBuilder(URI.create(baseUrl + path)).timeout(Duration.ofSeconds(60))
    if (authenticated) builder.header('Authorization', fields[1])
    if (payload != null) {
        builder.header('Content-Type', 'application/json; charset=utf-8')
        builder.POST(HttpRequest.BodyPublishers.ofString(JsonOutput.toJson(payload)))
    } else {
        builder.GET()
    }
    def response = client.send(builder.build(), HttpResponse.BodyHandlers.ofString())
    def json = new JsonSlurper().parseText(response.body())
    if (response.statusCode() != 200 || String.valueOf(json.code) != '0') {
        throw new IllegalStateException(method + ' ' + path + ': ' + json.message)
    }
    json
}

try {
    send('GET', '/api/ticket-service/ticket/query?fromStation=VNP&toStation=NGH&departureDate=' + LocalDate.now(), null, false)
    def purchase = send('POST', '/api/ticket-service/ticket/purchase', [
            trainId: '1', passengers: [[passengerId: fields[2], seatType: 2]], chooseSeats: [],
            departure: '北京南', arrival: '宁波'
    ], true)
    def orderSn = String.valueOf(purchase.data.orderSn)
    def pending = send('GET', '/api/order-service/order/ticket/query?orderSn=' + orderSn, null, true)
    if (pending.data.status as int != 0) throw new IllegalStateException('order is not pending')
    def pay = send('POST', '/api/pay-service/pay/create', [orderSn: orderSn, channel: 'MOCK_PAY', tradeType: 'NATIVE'], true)
    def paySn = String.valueOf(pay.data.paySn)
    send('GET', '/api/pay-service/pay/mock-cashier?paySn=' + paySn, null, false)
    def paid = null
    for (int attempt = 0; attempt < 20; attempt++) {
        paid = send('GET', '/api/order-service/order/ticket/query?orderSn=' + orderSn, null, true)
        if (paid.data.status as int == 10) break
        Thread.sleep(500)
    }
    if (paid == null || paid.data.status as int != 10) throw new IllegalStateException('order is not paid after 10 seconds')
    SampleResult.setSuccessful(true); SampleResult.setResponseCode('200'); SampleResult.setResponseMessage('FLOW_SUCCESS')
    SampleResult.setResponseData(JsonOutput.toJson([username: fields[0], orderSn: orderSn, paySn: paySn]), 'UTF-8')
} catch (Throwable ex) {
    SampleResult.setSuccessful(false); SampleResult.setResponseCode('500'); SampleResult.setResponseMessage('FLOW_FAILED: ' + ex.message)
    SampleResult.setResponseData(ex.toString(), 'UTF-8')
}
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
