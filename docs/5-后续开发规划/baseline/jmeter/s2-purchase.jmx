<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="D1 S2 购票抢票">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S2 50人抢10张票">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,1)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.delayedStart">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S2 POST purchase seatType=0">
          <stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">s2-purchase-v1</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.time.Duration

def client = vars.getObject('d1.http.client')
if (client == null) {
    client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()
    vars.putObject('d1.http.client', client)
}
def lines = props.get('d1.user.lines')
if (lines == null) {
    synchronized (props) {
        lines = props.get('d1.user.lines')
        if (lines == null) {
            lines = new File(props.getProperty('userFile')).readLines('UTF-8').drop(1)
            props.put('d1.user.lines', lines)
        }
    }
}
def fields = lines[ctx.getThreadNum()].split(',', 3)
def body = JsonOutput.toJson([
        trainId: '1', passengers: [[passengerId: fields[2], seatType: 0]], chooseSeats: [],
        departure: '北京南', arrival: '宁波'
])
def request = HttpRequest.newBuilder(URI.create(props.getProperty('baseUrl', 'http://127.0.0.1:9000') + '/api/ticket-service/ticket/purchase'))
        .timeout(Duration.ofSeconds(60)).header('Content-Type', 'application/json; charset=utf-8')
        .header('Authorization', fields[1]).POST(HttpRequest.BodyPublishers.ofString(body)).build()
def response = client.send(request, HttpResponse.BodyHandlers.ofString())
SampleResult.setResponseCode(String.valueOf(response.statusCode()))
SampleResult.setResponseData(response.body(), 'UTF-8')
def json = new JsonSlurper().parseText(response.body())
if (response.statusCode() == 200 && String.valueOf(json.code) == '0') {
    SampleResult.setSuccessful(true); SampleResult.setResponseMessage('PURCHASE_SUCCESS')
} else {
    SampleResult.setSuccessful(false); SampleResult.setResponseMessage('PURCHASE_REJECTED: ' + json.message)
}
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
