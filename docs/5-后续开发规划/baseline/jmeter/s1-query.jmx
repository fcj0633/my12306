<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="D1 S1 查询并发">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S1 100线程持续查询">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,100)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,10)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.delayedStart">false</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S1 GET ticket query">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">s1-query-v1</stringProp>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.time.Duration
import java.time.LocalDate

def client = vars.getObject('d1.http.client')
if (client == null) {
    client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()
    vars.putObject('d1.http.client', client)
}
def baseUrl = props.getProperty('baseUrl', 'http://127.0.0.1:9000')
def path = '/api/ticket-service/ticket/query?fromStation=VNP&toStation=NGH&departureDate=' + LocalDate.now()
def request = HttpRequest.newBuilder(URI.create(baseUrl + path)).timeout(Duration.ofSeconds(30)).GET().build()
def response = client.send(request, HttpResponse.BodyHandlers.ofString())
SampleResult.setResponseCode(String.valueOf(response.statusCode()))
SampleResult.setResponseData(response.body(), 'UTF-8')
def json = new JsonSlurper().parseText(response.body())
if (response.statusCode() != 200 || String.valueOf(json.code) != '0') {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('QUERY_FAILED: ' + json.message)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage('OK')
}
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
